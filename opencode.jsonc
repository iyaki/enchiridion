{
	"$schema": "https://opencode.ai/config.json",
	"compaction": {
		"auto": false,
		"prune": true,
		"reserved": 0
	},
	"permission": {
		"bash": {
			"git commit*-n*": "deny",
			"git commit*--no-verify*": "deny"
		},
		"edit": {
			".go-arch-lint": "ask",
			".golangci.yml": "ask",
			".gremlins.yaml": "ask",
			"lefthook.yml": "ask",
			"opencode.jsonc": "ask",
			"logs/*": "deny",
			"/tmp/*": "allow"
		}
	},
	"mcp": {
		"tech-docs": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"web-search": {
			"type": "local",
			"command": [ "npx", "-y", "open-websearch@latest" ],
			"environment": {
				"MODE": "stdio",
				"DEFAULT_SEARCH_ENGINE": "duckduckgo"
			},
			"enabled": true
		},
		"code-examples": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		},
		"repository-context": {
			"type": "remote",
			"url": "https://gitmcp.io/docs",
			"enabled": true
		},
		"async-bash": {
			"type": "local",
			"command": [ "uvx", "async-bash-mcp" ],
			"enabled": false
		}
	},
	"plugin": [
		"envsitter-guard@latest",
		"@slkiser/opencode-quota"
	]
}
